{
  "schemaVersion": 1,
  "name": "DSH Suite",
  "version": "0.8.0",
  "status": "release-candidate",
  "upstream": { "name": "DeepSeek Harness", "bundled": false, "testedVersion": "0.1.1-rc.2" },
  "modules": [
    { "id": "supervisor", "path": "bin/dsh-suite.js", "platform": "linux-wsl", "optional": false },
    { "id": "desktop", "path": "desktop/windows", "platform": "windows-webview2", "optional": true },
    { "id": "usage", "path": "desktop/linux", "platform": "linux-wsl", "optional": true },
    { "id": "remote", "path": "bin/dsh-remote.js", "platform": "node", "optional": true },
    { "id": "phone", "path": "phone", "platform": "pwa", "optional": true },
    { "id": "android", "path": "android", "platform": "android", "optional": true },
    { "id": "relay", "path": "vercel", "platform": "vercel-redis", "optional": true },
    { "id": "novatab", "path": "modules/novatab", "platform": "chromium-extension", "optional": true }
