UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
# Vercel Marketplace 使用自定义前缀时也支持：
# UPSTASH_REDIS_REST_KV_REST_API_URL / UPSTASH_REDIS_REST_KV_REST_API_TOKEN
DSH_RELAY_CHANNEL=replace-with-channel-from-config
DSH_RELAY_AUTH_SHA256=replace-with-sha256-from-init-output
DSH_ALLOWED_ORIGINS=https://your-relay.example.invalid,https://appassets.androidplatform.net
# Optional per-deployment namespace. Leave empty for compatibility with existing DR2 streams.
DSH_RELAY_NAMESPACE=
